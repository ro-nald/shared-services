# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it.
#
# In CI, github_org is sourced automatically from github.repository_owner.
# Locally, set it to your GitHub username or organisation.

aws_region  = "ap-east-1"
github_org  = ""            # e.g. "ro-nald" or "acme-corp"
github_repo = "shared-services"

# Add each workload account ID after running:
#   uv run scripts/bootstrap.py bootstrap-account --account-id <id> --env <env>
# workload_account_ids = ["123456789012", "234567890123"]

tags = {
  Team      = "platform"
  ManagedBy = "terraform"
}
